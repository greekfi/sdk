{
  "name": "@greekfi/sdk",
  "version": "0.1.0",
  "description": "Greek chains, tokens, deployments, ABIs, and RPCs",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "test": "tsx --test test/*.test.ts",
    "check-types": "tsc --noEmit",
    "generate:abi": "node scripts/generateAbi.mjs",
    "register": "node scripts/registerDeployment.mjs",
    "check": "node scripts/generateAbi.mjs --check && node scripts/registerDeployment.mjs --all --check && tsx --test test/*.test.ts",
    "sync:stocks": "node scripts/syncCbStocks.mjs",
    "verify:vanity": "node scripts/verify-vanity.mjs"
  },
  "devDependencies": {
    "@types/node": "^24",
    "prettier": "^3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "viem": "^2"
  },
  "packageManager": "yarn@4.13.0"
}
